# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model IDs are defined in backend/app/core/models.py and validated at startup.
# Re-check them against the current Anthropic model list before any migration.
LLM_MODEL_GENERATION=claude-opus-5      # grounded drafting; claude-opus-4-8 also accepted
LLM_MODEL_CLASSIFY=claude-haiku-4-5     # requirement extraction, routing, tagging
LLM_EFFORT=high                         # low|medium|high|xhigh|max
LLM_MAX_TOKENS=64000                    # streamed; see ADR-0003

# ─── Embeddings & rerank (Anthropic ships no embedding model — see ADR-0001) ──
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-multilingual-2
RERANK_MODEL=rerank-2

# ─── Datastores ──────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://rfp:rfp@localhost:5432/rfp
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks             # ONE collection, tenant-partitioned
REDIS_URL=redis://localhost:6379/0

# ─── Object storage ──────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rfp-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── Grounding policy ────────────────────────────────────────────────────────
MIN_RETRIEVAL_SCORE=0.35                # below this -> abstain, do not generate
MIN_CITATION_COVERAGE=0.90              # frac. of claim sentences needing a cite
ABSTAIN_ON_UNGROUNDED=true              # hard fail closed
REQUIRE_HUMAN_APPROVAL=true

# ─── App ─────────────────────────────────────────────────────────────────────
# Must be >=32 bytes. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-generated-48-byte-urlsafe-token
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── docker compose ──────────────────────────────────────────────────────────
# Used by docker-compose.yml only. Inside the stack the service names replace
# localhost, so POSTGRES_DSN/QDRANT_URL/REDIS_URL above are for running the API
# directly on the host.
POSTGRES_PASSWORD=postgres
RFP_APP_PASSWORD=rfp_app                # the unprivileged role the API uses
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

