# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_GENERATION=claude-opus-5      # grounded drafting + citation synthesis
LLM_MODEL_CLASSIFY=claude-haiku-4-5     # requirement extraction, routing, tagging
LLM_EFFORT=high                         # low|medium|high|xhigh|max
LLM_MAX_TOKENS=64000                    # streamed; see ADR-0003

# ─── Embeddings & rerank (Anthropic ships no embedding model — see ADR-0001) ──
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-multilingual-2
RERANK_MODEL=rerank-2

# ─── Datastores ──────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://rfp:rfp@localhost:5432/rfp
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks             # ONE collection, tenant-partitioned
REDIS_URL=redis://localhost:6379/0

# ─── Object storage ──────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rfp-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── Grounding policy ────────────────────────────────────────────────────────
MIN_RETRIEVAL_SCORE=0.35                # below this -> abstain, do not generate
MIN_CITATION_COVERAGE=0.90              # frac. of claim sentences needing a cite
ABSTAIN_ON_UNGROUNDED=true              # hard fail closed
REQUIRE_HUMAN_APPROVAL=true

# ─── App ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
